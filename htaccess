RewriteEngine On############################################# FORCE HTTPS + WWW (SINGLE RULE ONLY)############################################RewriteCond %{HTTPS} !=on [OR]RewriteCond %{HTTP_HOST} !^www\.gims\.net\.in$ [NC]RewriteRule ^(.*)$ https://www.gims.net.in/$1 [R=301,L]############################################# REMOVE index.php FROM URL############################################RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php [NC]RewriteRule ^ %1 [R=301,L]############################################# CUSTOM URL HANDLING############################################RewriteRule ^([a-zA-Z0-9_-]+)\.html$ latest-news-detailed.php?n=$1 [L,QSA]RewriteRule ^life-at-gims/([a-zA-Z0-9_-]+)\.html$ life-gims-detailed.php?n=$1 [L,QSA]############################################# PDF REDIRECTS (NO LOOPS)############################################RewriteRule ^pdf/admission-form-gims\.pdf$ /pdf/GIMS-Admission-form.pdf [R=301,L]RewriteRule ^pdf/gims-brochure-2022\.pdf$ /pdf/pgdm-brochure-2023-gims-greater-noida.pdf [R=301,L]RewriteRule ^gims-brochure/?$ /pdf/pgdm-brochure-2023-gims-greater-noida.pdf [R=301,L]RewriteRule ^pdf/gims-admission-form-2023\.pdf$ /pdf/GIMS-Admission-form.pdf [R=301,L]RewriteRule ^pdf/gims-e-form\.pdf$ /pdf/GIMS-Admission-form.pdf [R=301,L]RewriteRule ^pdf/pgdm-brochure-2023-gims-greater-noida\.pdf$ /pdf/gims-2023.pdf [R=301,L]############################################# ERROR DOCUMENTS (NO REDIRECT LOOP)############################################ErrorDocument 404 /index.phpErrorDocument 500 /index.phpErrorDocument 403 /index.php############################################# BROWSER CACHING############################################<IfModule mod_expires.c>  ExpiresActive On  ExpiresByType image/jpg "access 7 days"  ExpiresByType image/jpeg "access 7 days"  ExpiresByType image/png "access 7 days"  ExpiresByType text/css "access 7 days"  ExpiresByType application/pdf "access 30 days"  ExpiresDefault "access 7 days"</IfModule>############################################# GZIP COMPRESSION############################################<IfModule mod_deflate.c>  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json</IfModule>############################################# PHP HANDLER (cPanel)############################################<IfModule mime_module>  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml</IfModule>